# Managed by Ansible (roles/time_sync). Local time servers by address only.
{% for s in time_sync_ntpd_servers %}
server {{ s }} iburst minpoll {{ time_sync_client_minpoll }} maxpoll {{ time_sync_client_maxpoll }}{{ ' prefer' if s == time_sync_ntpd_prefer else '' }}
{% endfor %}
server 77.40.226.121 iburst

restrict default limited kod nomodify notrap noquery nopeer
restrict source  limited kod nomodify notrap noquery
restrict 127.0.0.1
restrict ::1

leapfile "/var/db/ntpd.leap-seconds.list"
driftfile /var/db/ntpd.drift
