apiVersion: v1
kind: Secret
metadata:
  name: "{{ playout_live_secret_name }}"
  namespace: "{{ playout_live_secret_namespace }}"
type: Opaque
stringData:
  # A Django "Playout reader" stream credential, <key UUID>:<password>. It
  # reads contrib/live/<UUID> of any enabled source, so it never changes as
  # sources are added.
  LIVE_READER_CREDENTIAL: "{{ playout_live_issued.username }}:{{ playout_live_issued.password }}"
