# {{ ansible_managed }}
listen = "{{ ttxd_listen }}"
{% if ttxd_t42_listen %}
t42_listen = "{{ ttxd_t42_listen }}"
{% endif %}
snapshot = "/var/lib/ttxd/pages.json"
service_name = "{{ ttxd_service_name }}"
decklink_device = "{{ ttxd_decklink_device }}"
vanc_line = {{ ttxd_vanc_line }}
op47_lines = {{ ttxd_op47_lines | to_json }}
{% for p in ttxd_publishers %}

[[publisher]]
name = "{{ p.name }}"
token = "{{ p.token }}"
pages = {{ p.pages | default([]) | to_json }}
subtitles = {{ p.subtitles | default(false) | lower }}
flash_per_sec = {{ p.flash_per_sec | default(100) }}
{% endfor %}
