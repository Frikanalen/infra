$TTL {{ dns_soa_minimum }}
@   IN SOA  ns1.{{ zone.name }}. hostmaster.{{ zone.name }}. (
        {{ dns_soa_serial }} ; serial
        {{ dns_soa_refresh }} ; refresh
        {{ dns_soa_retry }}   ; retry
        {{ dns_soa_expire }}  ; expire
        {{ dns_soa_minimum }} ; minimum
)

    IN NS   ns1.{{ zone.name }}.

; Name server A record -- always public: external resolvers and Let's
; Encrypt must be able to reach this nameserver on port 53.
ns1 IN A {{ zone.ns1_address }}

; Root A record
@   IN A {{ zone.apex_address }}


; Records below can be managed via RFC2136 dynamic updates
