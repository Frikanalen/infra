apiVersion: v1
kind: Secret
metadata:
  name: {{ junos_exporter_secret_name }}
  namespace: {{ junos_exporter_namespace }}
  labels:
    app: junos-exporter
type: Opaque
stringData:
  # Private half only. The public half is on fksw, in its configuration, and
  # in data/vault.yml next to this key -- the exporter has no use for it.
  {{ junos_exporter_ssh_key_filename }}: |
{{ junos_exporter_ssh_private_key | indent(4, first=True) }}
