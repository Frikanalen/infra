apiVersion: v1
kind: ConfigMap
metadata:
  name: junos-exporter-config
  namespace: {{ junos_exporter_namespace }}
  labels:
    app: junos-exporter
data:
  config.yml: |
    # One device, no host_pattern: fksw is the only Junos box here. The
    # username and key come from the command line (see the Deployment), so
    # they are deliberately not repeated per-device.
    devices:
      - host: {{ junos_exporter_target }}

    # Every known feature, explicitly. Omitting one does not disable it --
    # the exporter merges this file over its own defaults, several of which
    # are true. See junos_exporter_known_features in the role defaults.
    features:
{% for feature in junos_exporter_known_features | sort %}
      {{ feature }}: {{ 'true' if feature in junos_exporter_enabled_features else 'false' }}
{% endfor %}
