apiVersion: v1
kind: Secret
metadata:
  name: "{{ ingest_api_secret_name }}"
  namespace: "{{ ingest_api_secret_namespace }}"
type: Opaque
stringData:
  # Key name must match api.tokenKey in the ingest chart. A DRF auth token for
  # the ingest user, obtained from /api/obtain-token; these do not expire.
  token: "{{ ingest_api_token }}"
