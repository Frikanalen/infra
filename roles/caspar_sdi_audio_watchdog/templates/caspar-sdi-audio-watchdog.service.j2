# {{ ansible_managed }}
[Unit]
Description=Restart CasparCG when its DeckLink SDI audio is jammed
After=network-online.target nodm.service
Wants=network-online.target

[Service]
Environment=PRE_URL={{ caspar_sdi_audio_watchdog_pre_url }}
Environment=POST_URL={{ caspar_sdi_audio_watchdog_post_url }}
Environment=PRE_MIN_DBFS={{ caspar_sdi_audio_watchdog_pre_min_dbfs }}
Environment=POST_MAX_DBFS={{ caspar_sdi_audio_watchdog_post_max_dbfs }}
Environment=JAM_SECONDS={{ caspar_sdi_audio_watchdog_jam_seconds }}
Environment=STALE_SECONDS={{ caspar_sdi_audio_watchdog_stale_seconds }}
Environment=COOLDOWN_SECONDS={{ caspar_sdi_audio_watchdog_cooldown_seconds }}
Environment=MAX_RESTARTS={{ caspar_sdi_audio_watchdog_max_restarts }}
Environment=WINDOW_SECONDS={{ caspar_sdi_audio_watchdog_window_seconds }}
Environment="RESTART_COMMAND={{ caspar_sdi_audio_watchdog_restart_command }}"
Environment="SOFT_REMEDY_COMMAND={{ caspar_sdi_audio_watchdog_soft_remedy_command }}"
Environment=VERIFY_SECONDS={{ caspar_sdi_audio_watchdog_verify_seconds }}
Environment=MAX_BACKOFF_SECONDS={{ caspar_sdi_audio_watchdog_max_backoff_seconds }}
Environment=FAILURE_RESET_SECONDS={{ caspar_sdi_audio_watchdog_failure_reset_seconds }}
Environment=DRY_RUN={{ caspar_sdi_audio_watchdog_dry_run | lower }}
Environment=STATE_FILE=/var/lib/caspar-sdi-audio-watchdog/state.json
Environment=METRICS_FILE={{ caspar_sdi_audio_watchdog_metrics_file }}
Environment=ATEM_URL={{ caspar_sdi_audio_watchdog_atem_url }}
Environment=ATEM_INPUT={{ caspar_sdi_audio_watchdog_atem_input }}
Environment=ATEM_ME={{ caspar_sdi_audio_watchdog_atem_me }}
Environment="ATEM_INPUT_NAME={{ caspar_sdi_audio_watchdog_atem_input_name }}"
Environment=PROGRAM_GRACE_SECONDS={{ caspar_sdi_audio_watchdog_program_grace_seconds }}
Environment=ATEM_FLOOR_DBFS={{ caspar_sdi_audio_watchdog_atem_floor_dbfs }}
Environment=ATEM_ALIVE_DBFS={{ caspar_sdi_audio_watchdog_atem_alive_dbfs }}
Environment=PRE_SILENCE_DBFS={{ caspar_sdi_audio_watchdog_pre_silence_dbfs }}
Environment=LEVELS_STALE_SECONDS={{ caspar_sdi_audio_watchdog_levels_stale_seconds }}
Environment=RESTART_OFF_PROGRAM={{ caspar_sdi_audio_watchdog_restart_off_program | lower }}
Environment=ON_UNKNOWN_PROGRAM={{ caspar_sdi_audio_watchdog_on_unknown_program }}
Environment=DROPOUT_NOISE_DBFS={{ caspar_sdi_audio_watchdog_dropout_noise_dbfs }}
Environment=DROPOUT_MIN_SAMPLES={{ caspar_sdi_audio_watchdog_dropout_min_samples }}
Environment=DROPOUT_MAX_SECONDS={{ caspar_sdi_audio_watchdog_dropout_max_seconds }}
Environment=DROPOUT_CONTEXT_DBFS={{ caspar_sdi_audio_watchdog_dropout_context_dbfs }}
Environment=DROPOUT_PER_MINUTE={{ caspar_sdi_audio_watchdog_dropout_per_minute }}
Environment=DROPOUT_SUSTAIN_SECONDS={{ caspar_sdi_audio_watchdog_dropout_sustain_seconds }}
Environment=RESTART_ON_SHARED_DROPOUTS={{ caspar_sdi_audio_watchdog_restart_on_shared_dropouts | lower }}
Environment=DIAG_LOG={{ caspar_sdi_audio_watchdog_diag_log }}
Environment=LEAD_STARVED_SAMPLES={{ caspar_sdi_audio_watchdog_lead_starved_samples }}
Environment=LEAD_HEALTHY_SAMPLES={{ caspar_sdi_audio_watchdog_lead_healthy_samples }}
Environment=LEAD_WINDOW_SECONDS={{ caspar_sdi_audio_watchdog_lead_window_seconds }}
Environment=LEAD_STARVED_SECONDS={{ caspar_sdi_audio_watchdog_lead_starved_seconds }}
# ATEM_TOKEN, kept out of the world-readable unit.
EnvironmentFile=-/etc/caspar-sdi-audio-watchdog.env
ExecStart=/usr/bin/python3 -u /usr/local/lib/caspar-sdi-audio-watchdog/caspar-sdi-audio-watchdog.py
StateDirectory=caspar-sdi-audio-watchdog
Restart=always
RestartSec=10
# Root, because it restarts nodm. Kept away from everything else.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/caspar-sdi-audio-watchdog -/var/lib/prometheus/node-exporter
Nice=10

[Install]
WantedBy=multi-user.target
