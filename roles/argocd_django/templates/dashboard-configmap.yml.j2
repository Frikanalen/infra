apiVersion: v1
kind: ConfigMap
metadata:
  name: django-api-dashboard
  namespace: {{ argocd_django_namespace }}
  labels:
    app: {{ argocd_django_app_name }}
    # Picked up by the kiwigrid k8s-sidecar that kube-prometheus-stack runs
    # next to Grafana, which watches every namespace for ConfigMaps with this
    # label -- see the same comment in roles/d9036_exporter.
    grafana_dashboard: "1"
data:
  django-api.json: |
{{ lookup('file', 'django-api-dashboard.json') | indent(4, first=True) }}
