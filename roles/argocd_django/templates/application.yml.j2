apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ argocd_django_app_name }}
  namespace: {{ argocd_namespace }}
spec:
  project: default
  ignoreDifferences:
    - group: ""
      kind: Secret
      name: django-secret
      namespace: "{{ argocd_django_namespace }}"
      jsonPointers:
        - /data
    # roles/kubegres_backup patches spec.backup onto this Application's own
    # Kubegres resource directly, since the chart's Kubegres template
    # doesn't render that stanza and so never sets it itself. Without this,
    # selfHeal would prune it back out on the next sync.
    - group: kubegres.reactive-tech.io
      kind: Kubegres
      name: "{{ argocd_django_db_host }}"
      namespace: "{{ argocd_django_namespace }}"
      jsonPointers:
        - /spec/backup
  source:
    repoURL: "{{ argocd_django_repo_url }}"
    targetRevision: "{{ argocd_django_version }}"
    path: "{{ argocd_django_repo_path }}"
    helm:
      values: |
{{ argocd_django_values | to_nice_yaml(indent=2) | indent(8, first=True) }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ argocd_django_namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
