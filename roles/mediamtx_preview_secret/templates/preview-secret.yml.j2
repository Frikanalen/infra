apiVersion: v1
kind: Secret
metadata:
  name: "{{ mediamtx_preview_secret_name }}"
  namespace: "{{ mediamtx_preview_secret_namespace }}"
type: Opaque
stringData:
  # A Django "Preview converter (all enabled sources)" stream credential. It
  # reads contrib/live/<UUID> and publishes contrib/preview/<UUID> of any
  # enabled source over RTSP, so it never changes as sources are added.
  username: "{{ mediamtx_preview_issued.username }}"
  password: "{{ mediamtx_preview_issued.password }}"
