apiVersion: argocd-image-updater.argoproj.io/v1alpha1
kind: ImageUpdater
metadata:
  name: {{ _app.name }}
  namespace: {{ argocd_namespace }}
spec:
  applicationRefs:
    - namePattern: "{{ _app.name }}"
      images:
        - alias: {{ _app.name }}
          # version is a git revision; a branch with a slash in its name is
          # published under the same name with dashes (docker/metadata-action).
          imageName: "{{ _app.image_repository }}:{{ _app.version | replace('/', '-') }}"
          manifestTargets:
            helm:
              name: {{ _app.helm_image_key }}.repository
              tag: {{ _app.helm_image_key }}.tag
          commonUpdateSettings:
            updateStrategy: digest
      writeBackConfig:
        method: argocd
