apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: {{ node_exporter_scrape_service_name }}
  namespace: {{ node_exporter_scrape_namespace }}
  labels:
    app: {{ node_exporter_scrape_service_name }}
spec:
  # No release label needed: roles/kube_prometheus_stack sets
  # serviceMonitorSelectorNilUsesHelmValues false, so Prometheus selects
  # every ServiceMonitor in the cluster rather than only its own chart's.
  selector:
    matchLabels:
      app: {{ node_exporter_scrape_service_name }}
  namespaceSelector:
    matchNames:
      - {{ node_exporter_scrape_namespace }}
  endpoints:
    - port: metrics
      interval: {{ node_exporter_scrape_interval }}
      scrapeTimeout: {{ node_exporter_scrape_timeout }}
      relabelings:
        # Hostname from the Endpoints object above, in place of the ip:port
        # Prometheus would otherwise use. Every alert and dashboard in this
        # role keys off it.
        - sourceLabels: [__meta_kubernetes_endpoint_hostname]
          targetLabel: instance
          regex: (.+)
          replacement: $1
          action: replace
