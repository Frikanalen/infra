apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: "{{ argocd_gitops_application_name }}"
  namespace: {{ argocd_namespace }}
spec:
  project: default
{% if argocd_gitops_ignore_image_updater %}
  # Argo CD Image Updater (write-back method "argocd") pins each image by
  # writing helm parameters into the child Application itself. Without this
  # the root would see that as drift and undo it on every sync.
  ignoreDifferences:
    - group: argoproj.io
      kind: Application
      jsonPointers:
        - /spec/source/helm/parameters
{% endif %}
  source:
    repoURL: "{{ argocd_gitops_repo_url }}"
    targetRevision: "{{ argocd_gitops_repo_revision }}"
    path: "{{ argocd_gitops_repo_path }}"
{% if argocd_gitops_recurse %}
    directory:
      recurse: true
{% endif %}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ argocd_namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
{% if argocd_gitops_ignore_image_updater %}
    syncOptions:
      - RespectIgnoreDifferences=true
{% endif %}
