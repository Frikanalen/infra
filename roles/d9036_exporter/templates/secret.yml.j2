apiVersion: v1
kind: Secret
metadata:
  name: {{ d9036_exporter_secret_name }}
  namespace: {{ d9036_exporter_namespace }}
  labels:
    app: d9036-exporter
type: Opaque
stringData:
  # Mounted as a file rather than injected as D9036_PASSWORD: the exporter
  # prefers --d9036.password-file, and a file does not show up in `kubectl
  # describe pod` or in the process environment of anything that gets a shell
  # in the container.
  password: {{ d9036_exporter_password | to_json }}
