apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: d9036-exporter
  namespace: {{ d9036_exporter_namespace }}
  labels:
    app: d9036-exporter
spec:
  # No release label needed: roles/kube_prometheus_stack sets
  # serviceMonitorSelectorNilUsesHelmValues false, so Prometheus selects every
  # ServiceMonitor in the cluster rather than only its own chart's.
  selector:
    matchLabels:
      app: d9036-exporter
  # Copies the Service's "device" label onto every series it scrapes.
  targetLabels:
    - device
  namespaceSelector:
    matchNames:
      - {{ d9036_exporter_namespace }}
  endpoints:
    - port: metrics
      interval: {{ d9036_exporter_scrape_interval }}
      scrapeTimeout: {{ d9036_exporter_scrape_timeout }}
