apiVersion: v1
kind: ConfigMap
metadata:
  name: d9036-exporter-dashboard
  namespace: {{ d9036_exporter_namespace }}
  labels:
    app: d9036-exporter
    # What makes Grafana pick this up: kube-prometheus-stack runs the kiwigrid
    # k8s-sidecar next to Grafana watching for ConfigMaps carrying this label
    # and drops their contents into Grafana's provisioning directory. The chart
    # sets searchNamespace: ALL, so this does not have to share a namespace
    # with the stack -- it sits in {{ d9036_exporter_namespace }} because that
    # is where the exporter is. labelValue is "1" in the chart, so the value is
    # matched too and this is not merely convention.
    grafana_dashboard: "1"
data:
  d9036-exporter.json: |
{{ lookup('file', 'd9036-exporter-dashboard.json') | indent(4, first=True) }}
