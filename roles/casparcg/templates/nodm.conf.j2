# /etc/default/nodm
NODM_ENABLED={{ nodm_enabled | ternary('true','false') }}
NODM_USER={{ casparcg_user }}
{#- prlimit: CasparCG starts with a soft core limit of 0, which systemd-coredump honours. -#}
{%- set prefix = '/usr/bin/prlimit --core=unlimited ' if casparcg_coredump else '' -%}
{%- set preload = '/usr/bin/env LD_PRELOAD=/usr/local/lib/mallinfo_clamp.so ' if casparcg_mallinfo_clamp else '' %}
# LD_PRELOAD: see roles/casparcg/files/mallinfo_clamp.c.
NODM_XSESSION="/usr/bin/systemd-cat -t casparcg -- {{ prefix }}{{ preload }}{{ casparcg_exec }} /etc/casparcg.config"
# You can set a timeout in seconds; uncomment and adjust if needed
# NODM_USER_TIMEOUT=30
