apiVersion: v1
kind: Secret
metadata:
  name: "{{ cnpg_cluster_backup_s3_secret_name }}"
  namespace: "{{ cnpg_cluster_namespace }}"
type: Opaque
stringData:
  ACCESS_KEY_ID: "{{ cnpg_cluster_backup_s3_key_id }}"
  ACCESS_SECRET_KEY: "{{ cnpg_cluster_backup_s3_secret_key }}"
  REGION: "{{ cnpg_cluster_backup_region }}"
