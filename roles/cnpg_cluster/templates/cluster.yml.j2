apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: "{{ cnpg_cluster_name }}"
  namespace: "{{ cnpg_cluster_namespace }}"
spec:
  instances: {{ cnpg_cluster_instances }}
  imageName: "{{ cnpg_cluster_image }}"
  enableSuperuserAccess: true
  superuserSecret:
    name: "{{ cnpg_cluster_superuser_secret_name }}"
  bootstrap:
    initdb:
      database: "{{ cnpg_cluster_database_name }}"
      owner: "{{ cnpg_cluster_database_user }}"
      secret:
        name: "{{ cnpg_cluster_app_secret_name }}"
{% if cnpg_cluster_import_host %}
      import:
        type: microservice
        databases:
          - "{{ cnpg_cluster_database_name }}"
        source:
          externalCluster: import-source
  externalClusters:
    - name: import-source
      connectionParameters:
        host: "{{ cnpg_cluster_import_host }}"
        user: postgres
        dbname: postgres
      password:
        name: "{{ cnpg_cluster_import_superuser_secret }}"
        key: "{{ cnpg_cluster_import_superuser_secret_key }}"
{% endif %}
{% if cnpg_cluster_backup_enabled %}
  plugins:
    - name: barman-cloud.cloudnative-pg.io
      isWALArchiver: true
      parameters:
        barmanObjectName: "{{ cnpg_cluster_backup_object_store_name }}"
{% endif %}
  storage:
    size: "{{ cnpg_cluster_storage_size }}"
    storageClass: "{{ cnpg_cluster_storage_class }}"
  monitoring:
    # The operator creates the PodMonitor itself, so this needs the
    # Prometheus Operator CRDs present -- see data/cluster.yml.
    enablePodMonitor: {{ k8s_monitoring_enabled | bool | lower }}
