# {{ ansible_managed }}
# Mail server (mailcow on mail1): mail ports on the prod ingress address

mail_ext_ip = "{{ mail_ext_ip }}"
mail_int_ip = "{{ mail_int_ip }}"
int_if = "{{ fw_int_if }}"
ext_if = "{{ fw_ext_if }}"
lan_net = "{{ fw_lan_net }}"
mail_tcp_ports = "{ {{ mail_tcp_ports | join(', ') }} }"

# mail1 has no public address of its own. Inbound mail ports on the prod
# ingress address go straight to it (rdr, no nat, so mailcow and rspamd see
# the sender's real address); HTTPS on that address is Traefik's, which
# passes mail.frikanalen.tv through by SNI. Outbound mail leaves through the
# relay (host_vars/mail1.yml, mailcow_relayhost), from util1's own address
# like every other LAN host, so nothing here needs to match a PTR.
rdr on $ext_if proto tcp from any to $mail_ext_ip port $mail_tcp_ports -> $mail_int_ip

# Hairpin: LAN hosts using mail.frikanalen.tv.
rdr on $int_if proto tcp from $lan_net to $mail_ext_ip port $mail_tcp_ports -> $mail_int_ip
nat on $int_if proto tcp from $lan_net to $mail_int_ip port $mail_tcp_ports -> ($int_if:0)

# Filter rules (pass)
pass in quick on $ext_if proto tcp from any to $mail_int_ip port $mail_tcp_ports
pass in quick on $int_if proto tcp from $lan_net to $mail_int_ip port $mail_tcp_ports scrub (max-mss 1400)
