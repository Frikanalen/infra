# {{ ansible_managed }}
# The ttxd token comes from $TTXD_TOKEN (/etc/ttx-pages/token.env).
ttxd_url = "{{ ttx_pages_ttxd_url }}"
api_url = "{{ ttx_pages_api_url }}"
poll_secs = {{ ttx_pages_poll_secs }}
refresh_secs = {{ ttx_pages_refresh_secs }}
ttl_secs = {{ ttx_pages_ttl_secs }}

[index]
page = "{{ ttx_pages_index_page }}"
tagline = "{{ ttx_pages_index_tagline }}"
footer = "{{ ttx_pages_index_footer }}"
{% for e in ttx_pages_index_entries %}

[[index.entry]]
page = "{{ e.page }}"
title = "{{ e.title }}"
{% if e.always | default(false) %}
always = true
{% endif %}
{% endfor %}
