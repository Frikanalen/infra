# {{ ansible_managed }}
[Unit]
Description=ttx-pages, studio teletext pages for ttxd
After=network-online.target ttxd.service
Wants=network-online.target

[Service]
DynamicUser=yes
EnvironmentFile=/etc/ttx-pages/token.env
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory={{ ttx_pages_src_dir }}/generator
ExecStart=/usr/bin/python3 -m teletext_pages.main /etc/ttx-pages/pages.toml
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
