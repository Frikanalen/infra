apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ cnpg_backup_pvc_name }}
  namespace: {{ cnpg_backup_namespace }}
spec:
  accessModes:
    - ReadWriteMany
  storageClassName: ""
  volumeName: {{ cnpg_backup_pv_name }}
  resources:
    requests:
      storage: {{ cnpg_backup_capacity }}
