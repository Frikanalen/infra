#!/bin/bash
# Refreshes the staging {{ staging_db_sync_db_name }} database from prod.
#
# Dumps prod's {{ staging_db_sync_db_service }} over a kubectl port-forward,
# then restores into staging's {{ staging_db_sync_db_service }} the same way,
# authenticating with the djangoPassword already sitting in each cluster's
# own {{ staging_db_sync_db_secret_name }} secret -- no credentials beyond
# what's already deployed by roles/argocd_django. {{ staging_db_sync_db_user }}
# owns every table it created via migrations, so it can dump and
# clean-restore its own database without needing superuser access.
#
# {{ ansible_managed }}
set -euo pipefail

export PATH="/snap/bin:$PATH"

KUBECTL="microk8s kubectl"
PROD_KUBECONFIG="{{ staging_db_sync_kubeconfig_path }}"
NAMESPACE="{{ staging_db_sync_namespace }}"
DB_SERVICE="{{ staging_db_sync_db_service }}"
DB_NAME="{{ staging_db_sync_db_name }}"
DB_USER="{{ staging_db_sync_db_user }}"
SECRET_NAME="{{ staging_db_sync_db_secret_name }}"
DJANGO_DEPLOYMENT="{{ staging_db_sync_django_deployment }}"
DJANGO_CONTAINER="{{ staging_db_sync_django_container }}"
PROD_PORT={{ staging_db_sync_prod_local_port }}
STAGING_PORT={{ staging_db_sync_staging_local_port }}

DUMP_FILE="$(mktemp /var/tmp/staging-db-sync.XXXXXX.pgdump)"
PROD_PF_PID=""
STAGING_PF_PID=""

cleanup() {
  if [ -n "$PROD_PF_PID" ]; then
    kill "$PROD_PF_PID" 2>/dev/null || true
  fi
  if [ -n "$STAGING_PF_PID" ]; then
    kill "$STAGING_PF_PID" 2>/dev/null || true
  fi
  rm -f "$DUMP_FILE"
}
trap cleanup EXIT

wait_for_port() {
  local port="$1"
  for _ in $(seq 1 30); do
    if pg_isready -h 127.0.0.1 -p "$port" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  echo "Timed out waiting for port $port to accept connections" >&2
  return 1
}

secret_password() {
  # Guarded rather than returned raw: an absent djangoPassword key yields an
  # empty jsonpath result that base64 decodes to nothing and exits 0, and the
  # `microk8s kubectl` wrapper likewise prints a message and exits 0 if the
  # node is ever demoted out of the control plane. Both would hand us an
  # empty password and surface as a puzzling authentication failure several
  # steps later.
  local pw
  pw="$($KUBECTL "$@" -n "$NAMESPACE" get secret "$SECRET_NAME" \
    -o jsonpath='{.data.djangoPassword}' | base64 -d)"
  if [ -z "$pw" ]; then
    echo "No djangoPassword found in secret $SECRET_NAME (args: $*)" >&2
    return 1
  fi
  printf '%s' "$pw"
}

echo "$(date -Is) Starting staging database refresh"

PROD_PASSWORD="$(secret_password --kubeconfig="$PROD_KUBECONFIG")"
STAGING_PASSWORD="$(secret_password)"

$KUBECTL --kubeconfig="$PROD_KUBECONFIG" -n "$NAMESPACE" port-forward "svc/$DB_SERVICE" "$PROD_PORT:5432" &
PROD_PF_PID=$!
wait_for_port "$PROD_PORT"

PGPASSWORD="$PROD_PASSWORD" pg_dump -h 127.0.0.1 -p "$PROD_PORT" -U "$DB_USER" -Fc -d "$DB_NAME" -f "$DUMP_FILE"

kill "$PROD_PF_PID" 2>/dev/null || true
wait "$PROD_PF_PID" 2>/dev/null || true
PROD_PF_PID=""

$KUBECTL -n "$NAMESPACE" port-forward "svc/$DB_SERVICE" "$STAGING_PORT:5432" &
STAGING_PF_PID=$!
wait_for_port "$STAGING_PORT"

# Drop what is actually in the schema, then restore, both in one transaction.
#
# Deliberately not `pg_restore --clean`: that only drops the objects present
# in the dump, and staging tracks main while prod tracks a release tag, so
# staging routinely holds tables prod has never heard of. Those survive the
# clean and then block dropping the keys they reference, which is precisely
# how this failed the first time it ran for real:
#
#   ERROR: cannot drop constraint fk_weeklyslot_pkey on table
#   public.fk_weeklyslot because other objects depend on it
#
# Enumerating what is really there and dropping it CASCADE does not care how
# far the two schemas have drifted, which is the whole point of a wipe-and-
# replace. It needs no privileges beyond the ones fkweb already has, since
# fkweb owns everything its own migrations created.
#
# Piping the restore into a single psql transaction keeps the swap atomic:
# staging serves last week's data right up to the commit, and a failure
# leaves it on last week's data rather than empty. That takes ACCESS
# EXCLUSIVE on every table at once, which an open Django transaction can
# block, so lock_timeout bounds the wait -- otherwise this holds the
# port-forward open until next Monday's run piles up behind it.
{
  cat <<'SQL'
DO $do$
DECLARE r RECORD;
BEGIN
  FOR r IN SELECT tablename FROM pg_tables WHERE schemaname = 'public' LOOP
    EXECUTE format('DROP TABLE IF EXISTS public.%I CASCADE', r.tablename);
  END LOOP;
END
$do$;
SQL
  # --no-acl as well as --no-owner: the dump carries prod's grants on schema
  # public, which fkweb cannot apply because it does not own the schema, and
  # they are not wanted anyway. Staging's grants belong to the Kubegres init
  # script, and fkweb owns every table it restores here regardless.
  pg_restore --no-owner --no-acl -f - "$DUMP_FILE"
} | PGPASSWORD="$STAGING_PASSWORD" PGOPTIONS="-c lock_timeout={{ staging_db_sync_lock_timeout }}" \
  psql -h 127.0.0.1 -p "$STAGING_PORT" -U "$DB_USER" -d "$DB_NAME" \
    --single-transaction -v ON_ERROR_STOP=1 -q

kill "$STAGING_PF_PID" 2>/dev/null || true
wait "$STAGING_PF_PID" 2>/dev/null || true
STAGING_PF_PID=""

# Prod may be behind staging's migrations (staging tracks main; prod tracks a
# release tag), so the schema pg_restore just brought in can lag what
# staging's Django code expects. Bring it forward the same way the chart's
# own db-migrate hook does on every deploy.
$KUBECTL -n "$NAMESPACE" exec "deploy/$DJANGO_DEPLOYMENT" -c "$DJANGO_CONTAINER" -- \
  python manage.py migrate --noinput

echo "$(date -Is) Staging database refresh complete"
