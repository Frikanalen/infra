apiVersion: v1
kind: Secret
metadata:
  name: "{{ ingest_archive_secret_name }}"
  namespace: "{{ ingest_archive_namespace }}"
type: Opaque
stringData:
  # Key names must match archive.ssh.privateKeyKey and knownHostsKey in the
  # ingest chart, which turns them into the paths ingest is pointed at.
  # id_ed25519.pub is kept alongside so later runs can reconcile
  # authorized_keys without regenerating the key.
  id_ed25519: |
{{ ingest_archive_private_key | indent(4, first=True) }}
  id_ed25519.pub: |
{{ ingest_archive_public_key | indent(4, first=True) }}
  known_hosts: |
{{ ingest_archive_known_hosts | indent(4, first=True) }}
