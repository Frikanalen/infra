# {{ ansible_managed }}
[Unit]
Description=Collect ZFS pool and dataset metrics for node_exporter
Documentation=file://{{ node_exporter_zfs_script_path }}
# Nothing to collect before the pools are imported.
After=zfs.target
ConditionPathIsDirectory={{ node_exporter_textfile_directory }}

[Service]
Type=oneshot
ExecStart={{ node_exporter_zfs_script_path }} {{ node_exporter_textfile_directory }}
# zpool(8) blocks indefinitely on a suspended pool -- the exact situation this
# is meant to report on. Bounded so a wedged run cannot sit there forever;
# Type=oneshot means the timer will not stack a second run on top of it either
# way, and node_textfile_mtime_seconds going stale is what surfaces it.
TimeoutStartSec=120
Nice=10
IOSchedulingClass=idle

# No [Install] section on purpose. This unit is started by
# zfs-collector.timer and by nothing else, so it has no business being
# enabled -- "systemctl status" reporting it as "disabled" is the correct
# resting state for a timer-driven oneshot, not something to fix. Run it by
# hand with "systemctl start zfs-textfile-collector.service", which is
# exactly what the timer does.
