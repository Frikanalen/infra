+    // EXPERIMENT 0004: converts one primary port frame (both fields when interlaced), timed. Without "pool" this
+    // is exactly the original convert_frame_for_port call.
+    xp::converted convert_primary(const core::const_frame& frame1, const core::const_frame& frame2)
+    {
+        xp::converted out;
+        const auto    start     = diag::steady_clock::now();
+        const auto    dominance = mode_->GetFieldDominance();
+
+        if (sdk_pool_) {
+            const int slot = sdk_pool_->acquire();
+            out.alloc_us   = diag::us_between(start, diag::steady_clock::now());
+            if (slot >= 0) {
+                bool ok = false;
+                try {
+                    ok = format_strategy_->convert_frame_for_port_into(sdk_pool_->bytes(slot),
+                                                                       sdk_pool_->bytes(),
+                                                                       channel_format_desc_,
+                                                                       decklink_format_desc_,
+                                                                       config_.primary,
+                                                                       frame1,
+                                                                       frame2,
+                                                                       dominance);
+                } catch (...) {
+                    sdk_pool_->release(slot);
+                    throw;
+                }
+                if (ok) {
+                    out.sdk_slot = slot;
+                } else {
+                    sdk_pool_->release(slot);
+                }
+            }
+            (out.sdk_slot >= 0 ? out.pool_hit : out.pool_miss) = 1;
+        } else if (heap_pool_) {
+            bool hit     = false;
+            auto buffer  = heap_pool_->acquire(hit);
+            out.alloc_us = diag::us_between(start, diag::steady_clock::now());
+            if (format_strategy_->convert_frame_for_port_into(buffer.get(),
+                                                              heap_pool_->bytes(),
+                                                              channel_format_desc_,
+                                                              decklink_format_desc_,
+                                                              config_.primary,
+                                                              frame1,
+                                                              frame2,
+                                                              dominance)) {
+                out.image_data                       = std::move(buffer);
+                (hit ? out.pool_hit : out.pool_miss) = 1;
+            } else {
+                out.pool_miss = 1; // strategy cannot convert in place; buffer goes back to the pool
+            }
+        }
+
+        if (out.sdk_slot < 0 && !out.image_data) {
+            out.image_data = format_strategy_->convert_frame_for_port(
+                channel_format_desc_, decklink_format_desc_, config_.primary, frame1, frame2, dominance);
+        }
+
+        out.convert_us = diag::us_between(start, diag::steady_clock::now());
+        if (out.pool_hit)
+            exp_pool_hits_.fetch_add(1, std::memory_order_relaxed);
+        if (out.pool_miss)
+            exp_pool_misses_.fetch_add(1, std::memory_order_relaxed);
+        return out;
+    }
