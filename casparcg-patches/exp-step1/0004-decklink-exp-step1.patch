+/*
+ * EXPERIMENT BUILD (0004, step 1): runtime switchable changes to where and into what the primary port
+ * frame is converted. CASPAR_DECKLINK_EXP is a comma separated list of flags, read once per consumer:
+ *
+ *   ahead         convert in send() (consumer executor thread) and hand ready frames to the completion
+ *                 callback, which then only schedules. Queue depth: CASPAR_DECKLINK_EXP_QUEUE (default 3).
+ *   pool | pool=heap  convert into reused 128-byte aligned heap buffers (returned when the driver releases
+ *                 the frame) instead of allocating a new buffer per frame.
+ *   pool=sdk      convert into frames created with IDeckLinkOutput::CreateVideoFrame and schedule those
+ *                 directly (SDR only; falls back to pool=heap otherwise).
+ *   queue=N       ready queue depth for "ahead" (1..16); overrides CASPAR_DECKLINK_EXP_QUEUE.
+ *   nokeeper      disable the audio lead keeper (check_audio_lead is not called, so no correction is made).
+ *   base | none | off | -   no-op tokens (all experiments off).
+ *
+ * The first line of the file CASPAR_DECKLINK_EXP_FILE (default /run/casparcg/decklink-exp), when the file
+ * exists, overrides CASPAR_DECKLINK_EXP; an empty first line means all experiments off. The file is read
+ * when the consumer is created (ADD), so a bench can switch modes with REMOVE/ADD without a restart.
+ *
+ * Empty or unset: unchanged behaviour (only the cv_us timing is added to the diagnostics).
+ */
+namespace xp {
+
+enum class pool_mode
+{
+    off,
+    heap,
+    sdk
+};
+
+inline const char* pool_mode_name(pool_mode mode)
+{
+    switch (mode) {
+        case pool_mode::heap:
+            return "heap";
+        case pool_mode::sdk:
+            return "sdk";
+        default:
+            return "off";
+    }
+}
+
+struct flags
+{
+    bool        ahead    = false;
+    bool        nokeeper = false; // audio lead keeper disabled
+    pool_mode   pool     = pool_mode::off;
+    int         queue    = 3; // ready queue depth with "ahead"
+    std::string raw;          // flag string as given (file line or CASPAR_DECKLINK_EXP)
+    std::string source;       // "env" or "file:<path>"
+    std::string unknown;      // tokens that were not understood (ignored)
+};
+
+inline std::string trim(const std::string& value)
+{
+    const auto first = value.find_first_not_of(" \t");
+    if (first == std::string::npos)
+        return {};
+    const auto last = value.find_last_not_of(" \t");
+    return value.substr(first, last - first + 1);
+}
+
+inline bool parse_queue(const std::string& text, int& queue)
+{
+    if (text.empty())
+        return false;
+    char* tail  = nullptr;
+    auto  value = std::strtol(text.c_str(), &tail, 10);
+    if (tail == text.c_str() || *tail != '\0')
+        return false;
+    queue = static_cast<int>(std::clamp<long>(value, 1, 16));
+    return true;
+}
+
+inline flags parse_env()
+{
+    flags       result;
+    const char* env = std::getenv("CASPAR_DECKLINK_EXP");
+    result.raw      = env != nullptr ? env : "";
+    result.source   = "env";
+
+    // The bench writes the mode as the first line of this file; when it exists it wins over the environment.
+    const char*       file_env = std::getenv("CASPAR_DECKLINK_EXP_FILE");
+    const std::string path     = file_env != nullptr && *file_env != '\0' ? file_env : "/run/casparcg/decklink-exp";
+    try {
+        std::ifstream in(path);
+        if (in.is_open()) {
+            std::string line;
+            std::getline(in, line);
+            while (!line.empty() && (line.back() == '\r' || line.back() == '\n'))
+                line.pop_back();
+            result.raw    = line;
+            result.source = "file:" + path;
+        }
+    } catch (...) {
+        // unreadable: keep the environment value
+    }
+
+    if (const char* queue = std::getenv("CASPAR_DECKLINK_EXP_QUEUE"); queue != nullptr)
+        parse_queue(queue, result.queue);
+
+    std::size_t start = 0;
+    while (start <= result.raw.size()) {
+        auto end = result.raw.find(',', start);
+        if (end == std::string::npos)
+            end = result.raw.size();
+        auto token = trim(result.raw.substr(start, end - start));
+        std::transform(token.begin(), token.end(), token.begin(), [](unsigned char c) {
+            return static_cast<char>(std::tolower(c));
+        });
+        if (token == "ahead") {
+            result.ahead = true;
+        } else if (token == "pool" || token == "pool=heap") {
+            result.pool = pool_mode::heap;
+        } else if (token == "pool=sdk") {
+            result.pool = pool_mode::sdk;
+        } else if (token == "nokeeper") {
+            result.nokeeper = true;
+        } else if (token.rfind("queue=", 0) == 0 && parse_queue(token.substr(6), result.queue)) {
+            // ready queue depth for "ahead"
+        } else if (token == "base" || token == "none" || token == "off" || token == "-") {
+            // explicit "all experiments off"
+        } else if (!token.empty()) {
+            result.unknown += (result.unknown.empty() ? "" : ",") + token;
+        }
+        start = end + 1;
+    }
+    return result;
+}
+
+inline void* aligned_malloc(std::size_t bytes, std::size_t alignment)
+{
+    bytes = (bytes + alignment - 1) / alignment * alignment;
+#ifdef _MSC_VER
+    return _aligned_malloc(bytes, alignment);
+#else
+    return std::aligned_alloc(alignment, bytes);
+#endif
+}
+
+inline void aligned_free(void* ptr)
+{
+#ifdef _MSC_VER
+    _aligned_free(ptr);
+#else
+    std::free(ptr);
+#endif
+}
+
+// Free list of equally sized aligned buffers. A buffer goes back to the list when the last shared_ptr to it is
+// released, i.e. when the decklink_frame that wraps it is destroyed after the driver released it. The state is
+// shared with every outstanding buffer, so the pool may be destroyed before the driver lets go of its frames.
+class heap_pool
+{
+    struct state
+    {
+        std::mutex         mutex;
+        std::vector<void*> free_list;
+        std::size_t        bytes = 0;
+        std::size_t        keep  = 0; // at most this many idle buffers are kept
+
+        ~state()
+        {
+            for (auto ptr : free_list)
+                aligned_free(ptr);
+        }
+    };
+    std::shared_ptr<state> state_ = std::make_shared<state>();
+
+  public:
+    static constexpr std::size_t alignment = 128;
+
+    heap_pool(std::size_t bytes, std::size_t keep)
+    {
+        state_->bytes = bytes;
+        state_->keep  = keep;
+        state_->free_list.reserve(keep);
+    }
+
+    [[nodiscard]] std::size_t bytes() const { return state_->bytes; }
+
+    // hit = true when a buffer was reused, false when a new one had to be allocated.
+    std::shared_ptr<void> acquire(bool& hit)
+    {
+        void* ptr = nullptr;
+        {
+            std::lock_guard<std::mutex> lock(state_->mutex);
+            if (!state_->free_list.empty()) {
+                ptr = state_->free_list.back();
+                state_->free_list.pop_back();
+            }
+        }
+        hit = ptr != nullptr;
+        if (ptr == nullptr) {
+            ptr = aligned_malloc(state_->bytes, alignment);
+            if (ptr == nullptr)
+                throw std::bad_alloc();
+        }
+        auto st = state_;
+        return std::shared_ptr<void>(ptr, [st](void* p) {
+            {
+                std::lock_guard<std::mutex> lock(st->mutex);
+                if (st->free_list.size() < st->keep) {
+                    st->free_list.push_back(p);
+                    return;
+                }
+            }
+            aligned_free(p);
+        });
+    }
+};
+
+// Ring of driver allocated frames (IDeckLinkOutput::CreateVideoFrame). A slot is handed out again only when
+// the completion callback has reported its frame and the SDK reference count shows that only the pool holds it.
+// The slot also stores the schedule info that decklink_frame keeps for the diagnostics.
+class sdk_pool
+{
+    struct slot
+    {
+        com_ptr<IDeckLinkMutableVideoFrame> frame;
+        IDeckLinkVideoFrame*                raw          = nullptr;
+        void*                               bytes        = nullptr;
+        bool                                busy         = false;
+        BMDTimeValue                        display_time = -1;
+        BMDTimeValue                        audio_time   = -1;
+        int                                 nb_samples   = 0;
+    };
+    mutable std::mutex mutex_;
+    std::vector<slot>  slots_;
+    std::size_t        bytes_    = 0;
+    std::uint64_t      ref_busy_ = 0; // free by completion, but the SDK still held a reference
+    std::size_t        next_     = 0;
+
+  public:
+    // Returns an empty string on success, else the reason.
+    std::string
+    init(IDeckLinkOutput* output, int width, int height, int row_bytes, BMDPixelFormat pixel_format, std::size_t count)
+    {
+        bytes_ = static_cast<std::size_t>(row_bytes) * height;
+        for (std::size_t n = 0; n < count; ++n) {
+            IDeckLinkMutableVideoFrame* frame = nullptr;
+            if (FAILED(output->CreateVideoFrame(width, height, row_bytes, pixel_format, bmdFrameFlagDefault, &frame)) ||
+                frame == nullptr) {
+                return "CreateVideoFrame failed";
+            }
+            slot s;
+            s.frame = wrap_raw<com_ptr, IDeckLinkMutableVideoFrame>(frame, true);
+            s.raw   = static_cast<IDeckLinkVideoFrame*>(frame);
+            if (FAILED(frame->GetBytes(&s.bytes)) || s.bytes == nullptr)
+                return "GetBytes failed";
+            if ((reinterpret_cast<std::uintptr_t>(s.bytes) & 15) != 0)
+                return "frame buffer is not 16 byte aligned";
+            slots_.push_back(std::move(s));
+        }
+        return {};
+    }
+
+    [[nodiscard]] std::size_t bytes() const { return bytes_; }
+
+    [[nodiscard]] std::uint64_t ref_busy() const
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return ref_busy_;
+    }
+
+    // Returns a slot index, or -1 when every frame is still in use.
+    int acquire()
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        for (std::size_t i = 0; i < slots_.size(); ++i) {
+            const auto n = (next_ + i) % slots_.size();
+            auto&      s = slots_[n];
+            if (s.busy)
+                continue;
+            s.raw->AddRef();
+            if (s.raw->Release() > 1) {
+                ++ref_busy_;
+                continue;
+            }
+            s.busy         = true;
+            s.display_time = -1;
+            s.audio_time   = -1;
+            s.nb_samples   = 0;
+            next_          = (n + 1) % slots_.size();
+            return static_cast<int>(n);
+        }
+        return -1;
+    }
+
+    void* bytes(int index) const { return slots_.at(index).bytes; }
+
+    IDeckLinkVideoFrame* frame(int index) const { return slots_.at(index).raw; }
+
+    void set_schedule_info(int index, BMDTimeValue display_time, BMDTimeValue audio_time, int nb_samples)
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        auto&                       s = slots_.at(index);
+        s.display_time                = display_time;
+        s.audio_time                  = audio_time;
+        s.nb_samples                  = nb_samples;
+    }
+
+    void release(int index)
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        slots_.at(index).busy = false;
+    }
+
+    // Called from the completion callback. Returns true (and the schedule info) if the frame is one of ours.
+    bool complete(IDeckLinkVideoFrame* frame, BMDTimeValue& display_time, BMDTimeValue& audio_time, int& nb_samples)
+    {
+        if (frame == nullptr)
+            return false;
+        // The driver should hand back the pointer we scheduled, but match the buffer too: if a frame of ours
+        // were not recognised, the caller would treat a driver frame as a decklink_frame.
+        void* frame_bytes = nullptr;
+        if (FAILED(frame->GetBytes(&frame_bytes)))
+            frame_bytes = nullptr;
+        std::lock_guard<std::mutex> lock(mutex_);
+        for (auto& s : slots_) {
+            if (s.raw == frame || (frame_bytes != nullptr && s.bytes == frame_bytes)) {
+                display_time = s.display_time;
+                audio_time   = s.audio_time;
+                nb_samples   = s.nb_samples;
+                s.busy       = false;
+                return true;
+            }
+        }
+        return false;
+    }
+};
+
+// Result of converting one primary port frame (one decklink frame; both fields when interlaced).
+struct converted
+{
+    std::shared_ptr<void> image_data;      // heap data (wrapped in a decklink_frame at schedule time)
+    int                   sdk_slot   = -1; // >= 0: converted into this sdk_pool frame instead
+    std::int32_t          convert_us = 0;
+    std::int32_t          alloc_us   = -1;
+    std::int8_t           pool_hit   = 0;
+    std::int8_t           pool_miss  = 0;
+};
+
+// What send() hands to the completion callback with "ahead".
+struct ready_item
+{
+    converted                      video;
+    std::vector<std::int32_t>      audio;
+    int                            nb_samples = 0;
+    core::const_frame              frame1; // kept only when there are secondary ports
+    core::const_frame              frame2;
+    std::int32_t                   send_wait_us = 0;
+    diag::steady_clock::time_point ready_at{};
+};
