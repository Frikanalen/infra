+    // EXPERIMENT 0006: why this frame can't be scheduled zero-copy, or nullptr if it can.
+    const char* zerocopy_refusal(const core::const_frame& frame, BMDFieldDominance dominance) const
+    {
+        if (!frame)
+            return "empty-frame";
+        if (format_strategy_->get_pixel_format() != bmdFormat8BitBGRA)
+            return "not-bgra";
+        if (dominance != bmdProgressiveFrame)
+            return "interlaced";
+        const auto& c = config_.primary;
+        if (c.key_only)
+            return "key-only";
+        if (channel_format_desc_.format != decklink_format_desc_.format || c.src_x != 0 || c.src_y != 0 ||
+            c.region_w != 0 || c.region_h != 0 || c.dest_x != 0 || c.dest_y != 0)
+            return "region-or-format";
+        const auto& image = frame.image_data(0);
+        if (image.data() == nullptr ||
+            image.size() < static_cast<std::size_t>(decklink_format_desc_.width) * decklink_format_desc_.height * 4)
+            return "short-image";
+        if ((reinterpret_cast<std::uintptr_t>(image.data()) & 15) != 0)
+            return "unaligned";
+        return nullptr;
+    }
+
+    // EXPERIMENT 0006: static part of the eligibility, for the EXP line.
+    std::string zerocopy_eligibility() const
+    {
+        if (!exp_.zerocopy)
+            return "";
+        const auto& c = config_.primary;
+        if (format_strategy_->get_pixel_format() != bmdFormat8BitBGRA)
+            return " zc_static=not-bgra";
+        if (mode_->GetFieldDominance() != bmdProgressiveFrame)
+            return " zc_static=interlaced";
+        if (c.key_only)
+            return " zc_static=key-only";
+        if (channel_format_desc_.format != decklink_format_desc_.format || c.src_x != 0 || c.src_y != 0 ||
+            c.region_w != 0 || c.region_h != 0 || c.dest_x != 0 || c.dest_y != 0)
+            return " zc_static=region-or-format";
+        return " zc_static=ok";
+    }
