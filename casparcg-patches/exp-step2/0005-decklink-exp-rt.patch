+    // EXPERIMENT 0005: applies the wanted policy on the calling thread and writes one "RT thread=<cb|conv> tid=..
+    // want=<FIFO:n|OTHER> before=.. result=<ok|unchanged|failed:..>" line. A first call on a thread that is
+    // already as wanted is still logged (the arm's evidence); later "unchanged" calls are not.
+    void apply_rt(const char* which, bool fifo, bool first)
+    {
+        const auto before = xp::this_thread_policy();
+        const auto result = xp::set_this_thread_policy(fifo, exp_.rt_prio);
+        if (result == "unchanged" && !first)
+            return;
+        std::string line = std::string("RT thread=") + which + " tid=" + std::to_string(diag::current_tid()) +
+                           " want=" + (fifo ? "FIFO:" + std::to_string(exp_.rt_prio) : std::string("OTHER")) +
+                           " before=" + before + " result=" + result + " rtlimit=" + xp::rtprio_limit();
+        if (std::string(which) == "cb")
+            line += " thread_changes=" + std::to_string(exp_rt_cb_thread_changes_);
+        if (result.rfind("failed", 0) == 0)
+            CASPAR_LOG(warning) << print() << L" " << u16(line);
+        else
+            CASPAR_LOG(info) << print() << L" " << u16(line);
+        if (diag_)
+            diag_->post_text(line);
+    }
