+// EXPERIMENT 0005 "rt": SCHED_FIFO for one thread, with the outcome reported instead of ignored (the
+// common set_thread_realtime_priority() drops the return code, so on a box without RLIMIT_RTPRIO it silently
+// does nothing).
+inline bool parse_rtprio(const std::string& text, int& prio)
+{
+    if (text.empty())
+        return false;
+    char* tail  = nullptr;
+    auto  value = std::strtol(text.c_str(), &tail, 10);
+    if (tail == nullptr || *tail != '\0' || value < 1 || value > 49)
+        return false;
+    prio = static_cast<int>(value);
+    return true;
+}
+
+// Current policy of the calling thread as "FIFO:10" / "OTHER:0".
+inline std::string this_thread_policy()
+{
+#ifdef _WIN32
+    return "-";
+#else
+    int         policy = 0;
+    sched_param param{};
+    if (pthread_getschedparam(pthread_self(), &policy, &param) != 0)
+        return "?";
+    const char* name = policy == SCHED_FIFO ? "FIFO" : policy == SCHED_RR ? "RR" : "OTHER";
+    return std::string(name) + ":" + std::to_string(param.sched_priority);
+#endif
+}
+
+// Puts the calling thread on SCHED_FIFO:prio (fifo) or back on SCHED_OTHER:0 (!fifo). Returns "ok",
+// "unchanged" (already as wanted; nothing done) or "failed:<reason>".
+inline std::string set_this_thread_policy(bool fifo, int prio)
+{
+#ifdef _WIN32
+    (void)fifo;
+    (void)prio;
+    return "unsupported";
+#else
+    int         policy = 0;
+    sched_param param{};
+    if (pthread_getschedparam(pthread_self(), &policy, &param) != 0)
+        return "failed:getschedparam";
+    const bool is_rt = policy == SCHED_FIFO || policy == SCHED_RR;
+    if (fifo ? (policy == SCHED_FIFO && param.sched_priority == prio) : !is_rt)
+        return "unchanged";
+    param.sched_priority = fifo ? prio : 0;
+    const int rc         = pthread_setschedparam(pthread_self(), fifo ? SCHED_FIFO : SCHED_OTHER, &param);
+    if (rc != 0)
+        return std::string("failed:") + (rc == EPERM ? "EPERM" : rc == EINVAL ? "EINVAL" : std::to_string(rc));
+    if (pthread_getschedparam(pthread_self(), &policy, &param) != 0 || (policy == SCHED_FIFO) != fifo)
+        return "failed:not-applied";
+    return "ok";
+#endif
+}
+
+// Scheduling policy of this process's thread named `comm` (e.g. "channel-1"), for the EXP line.
+inline std::string thread_policy_by_name(const std::string& comm)
+{
+#ifdef _WIN32
+    (void)comm;
+    return "-";
+#else
+    try {
+        for (const auto& entry : boost::filesystem::directory_iterator("/proc/self/task")) {
+            std::ifstream in((entry.path() / "comm").string());
+            std::string   name;
+            std::getline(in, name);
+            if (name != comm)
+                continue;
+            const auto tid = static_cast<pid_t>(std::strtol(entry.path().filename().string().c_str(), nullptr, 10));
+            sched_param param{};
+            const int   policy = sched_getscheduler(tid);
+            if (policy < 0 || sched_getparam(tid, &param) != 0)
+                return "?";
+            const char* name_of = policy == SCHED_FIFO ? "FIFO" : policy == SCHED_RR ? "RR" : "OTHER";
+            return std::string(name_of) + ":" + std::to_string(param.sched_priority);
+        }
+    } catch (...) {
+    }
+    return "-";
+#endif
+}
+
+inline std::string rtprio_limit()
+{
+#ifdef _WIN32
+    return "-";
+#else
+    rlimit lim{};
+    if (getrlimit(RLIMIT_RTPRIO, &lim) != 0)
+        return "?";
+    return lim.rlim_cur == RLIM_INFINITY ? std::string("inf") : std::to_string(lim.rlim_cur);
+#endif
+}
