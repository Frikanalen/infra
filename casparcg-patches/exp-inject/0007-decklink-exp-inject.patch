+// EXPERIMENT 0007: "drop:S" or "stall:MS:S".
+inline bool parse_inject(const std::string& text, flags& f)
+{
+    auto number = [](const std::string& t, int lo, int hi, int& out) {
+        if (t.empty())
+            return false;
+        char* tail  = nullptr;
+        auto  value = std::strtol(t.c_str(), &tail, 10);
+        if (tail == nullptr || *tail != '\0' || value < lo || value > hi)
+            return false;
+        out = static_cast<int>(value);
+        return true;
+    };
+    if (text.rfind("drop:", 0) == 0) {
+        int every = 0;
+        if (!number(text.substr(5), 1, 3600, every))
+            return false;
+        f.inject_kind  = 1;
+        f.inject_every = every;
+        return true;
+    }
+    if (text.rfind("stall:", 0) == 0) {
+        const auto rest  = text.substr(6);
+        const auto colon = rest.find(':');
+        int        ms = 0, every = 0;
+        if (colon == std::string::npos || !number(rest.substr(0, colon), 1, 500, ms) ||
+            !number(rest.substr(colon + 1), 1, 3600, every))
+            return false;
+        f.inject_kind  = 2;
+        f.inject_ms    = ms;
+        f.inject_every = every;
+        return true;
+    }
+    return false;
+}
