+    void write(const std::string& text, bool is_event)
+    {
+        if (use_file_) {
+            std::lock_guard<std::mutex> lock(file_mutex());
+            file_ << text;
+            file_.flush();
+            if (file_.good())
+                return;
+            use_file_ = false;
+            CASPAR_LOG(warning) << u16(name_)
+                                << L" decklink diagnostics: write to log file failed, falling back to CASPAR_LOG(info)";
+        }
+
+        // Fallback: CASPAR_LOG(info), at most one event per second in addition to the per-second summary.
+        if (is_event) {
+            auto second = wall_ms_now() / 1000;
+            if (second == fallback_event_second_) {
+                ++suppressed_events_;
+                return;
+            }
+            fallback_event_second_ = second;
+        }
+        auto line = text;
+        while (!line.empty() && line.back() == '\n')
+            line.pop_back();
+        CASPAR_LOG(info) << u16(line);
+    }
