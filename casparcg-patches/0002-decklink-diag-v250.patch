+    std::int32_t ba_post_sched       = -1; // GetBufferedAudioSampleFrameCount right after ScheduleAudioSamples
+
+    std::int32_t stream_hr      = 0; // GetScheduledStreamTime at callback entry (video playhead)
+    std::int64_t stream_time    = 0;
