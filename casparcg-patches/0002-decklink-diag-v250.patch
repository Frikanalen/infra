+    // Prints up to `before` frames before and `after` frames after `center_frame` (from history).
+    std::string format_context(std::int64_t center_frame, int before, int after) const
+    {
+        std::string out;
+        for (const auto& s : history_) {
+            if (s.frame_no >= center_frame - before && s.frame_no <= center_frame + after)
+                out += format_frame(s);
+        }
+        return out;
+    }
+
+    bool allow_event(std::int64_t wall_ms)
+    {
+        auto second = wall_ms / 1000;
+        if (second != event_second_) {
+            event_second_       = second;
+            events_this_second_ = 0;
+        }
+        if (++events_this_second_ > max_events_per_second) {
+            ++suppressed_events_;
+            return false;
+        }
+        return true;
+    }
+
+    void emit_event(std::int64_t wall_ms, const std::string& header, std::int64_t center_frame, int after)
+    {
+        if (!allow_event(wall_ms))
+            return;
+        write(prefix(wall_ms) + " E " + header + "\n" + format_context(center_frame, context_before, after), true);
+    }
+
+    void emit_ready_events(bool force)
+    {
+        if (pending_.empty())
+            return;
+        const auto newest = history_.empty() ? 0 : history_.back().frame_no;
+        auto       it     = pending_.begin();
+        while (it != pending_.end()) {
+            if (force || newest >= it->frame_no + it->after) {
+                char head[64];
+                std::snprintf(head, sizeof(head), "fr=%lld ", static_cast<long long>(it->frame_no));
+                emit_event(it->wall_ms, head + it->reasons, it->frame_no, it->after);
+                it = pending_.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+
+    void add_pending(const frame_sample& s, const std::string& reasons, int after)
+    {
+        if (!pending_.empty() && pending_.back().frame_no == s.frame_no) {
+            pending_.back().reasons += " " + reasons;
+            pending_.back().after = std::max(pending_.back().after, after);
+            return;
+        }
+        pending_.push_back(pending_event{s.frame_no, s.wall_ms, reasons, after});
+    }
+
+    void flush_second()
+    {
+        if (agg_.n == 0)
+            return;
+
+        const auto& l         = agg_.last;
+        const auto  overflow  = overflow_.load(std::memory_order_relaxed);
+        const bool  has_unacc = agg_.unacc_min <= agg_.unacc_max;
+        const bool  has_lead  = agg_.sched_lead_min <= agg_.sched_lead_max;
+
+        char buf[1280];
+        std::snprintf(
+            buf,
+            sizeof(buf),
+            " S fr=%lld n=%d res=ok:%d,late:%d,drop:%d,flush:%d,other:%d ba=%d..%d ba_post=%d..%d bv=%d..%d "
+            "a_unacc=%lld..%lld av_skew=%lld..%lld s_lead=%lld..%lld ia=%.1f..%.1fms pop_max=%.1fms sv_max=%.1fms "
+            "sa_max=%.1fms cb_max=%.1fms ph=%lld spd=%.2f hw=%lld/%lld/%lld a_sched=%lld v_sched=%lld a_lead=%lld "
+            "v_lead=%lld late_adj=%d ph_jump=%d cft_step=%d sched_acc=%d ns_cad=%d short=%d ahr_fail=%d vhr_fail=%d "
+            "oncb=%d ovf=%llu sup=%d\n",
+            static_cast<long long>(l.frame_no),
+            agg_.n,
+            agg_.results[0],
+            agg_.results[1],
+            agg_.results[2],
+            agg_.results[3],
+            agg_.results[4],
+            agg_.ba_min,
+            agg_.ba_max,
+            agg_.ba_post_min,
+            agg_.ba_post_max,
+            agg_.bv_min,
+            agg_.bv_max,
+            static_cast<long long>(has_unacc ? agg_.unacc_min : 0),
+            static_cast<long long>(has_unacc ? agg_.unacc_max : 0),
+            static_cast<long long>(agg_.skew_min),
+            static_cast<long long>(agg_.skew_max),
+            static_cast<long long>(has_lead ? agg_.sched_lead_min : 0),
+            static_cast<long long>(has_lead ? agg_.sched_lead_max : 0),
+            (agg_.ia_min == INT32_MAX ? 0 : agg_.ia_min) / 1000.0,
+            agg_.ia_max / 1000.0,
+            agg_.pop_max / 1000.0,
+            agg_.sched_video_max / 1000.0,
+            agg_.sched_audio_max / 1000.0,
+            agg_.callback_max / 1000.0,
+            static_cast<long long>(l.stream_time),
+            l.playback_speed,
+            static_cast<long long>(l.hw_time),
+            static_cast<long long>(l.hw_in_frame),
+            static_cast<long long>(l.hw_per_frame),
+            static_cast<long long>(l.audio_scheduled_entry),
+            static_cast<long long>(l.video_scheduled_entry),
+            static_cast<long long>(l.audio_scheduled_entry - playhead_samples(l)),
+            static_cast<long long>(l.video_scheduled_entry - l.stream_time),
+            agg_.late_adjustments,
+            agg_.playhead_jumps,
+            agg_.cft_steps,
+            agg_.sched_accept,
+            agg_.ns_cadence,
+            agg_.short_writes,
+            agg_.audio_hr_failures,
+            agg_.video_hr_failures,
+            agg_.sched_on_cb,
+            static_cast<unsigned long long>(overflow - reported_overflow_),
+            suppressed_events_);
+        reported_overflow_ = overflow;
+        suppressed_events_ = 0;
+
+        write(prefix(l.wall_ms) + buf, false);
+
+        // Buffered-audio level step between consecutive seconds.
+        if (embedded_audio_ && prev_ba_min_ >= 0 && std::abs(agg_.ba_min - prev_ba_min_) >= event_ba_step_threshold) {
+            // Candidates in the last ~2.5 s of history: the two largest frame-to-frame buffered-audio deltas
+            // (may be DMA-chunk noise) and the largest a_unacc change (preferred when it is >= 480 samples).
+            std::int64_t ba_frame[2] = {agg_.first_frame, agg_.first_frame};
+            std::int32_t ba_delta[2] = {0, 0};
+            std::int64_t un_frame    = -1;
+            std::int64_t un_delta    = 0;
+            for (std::size_t i = 1; i < history_.size(); ++i) {
+                const auto& a = history_[i - 1];
+                const auto& b = history_[i];
+                if (b.frame_no < agg_.first_frame - 60 || a.buffered_audio < 0 || b.buffered_audio < 0)
+                    continue;
+                auto delta = b.buffered_audio - a.buffered_audio;
+                if (std::abs(delta) > std::abs(ba_delta[0])) {
+                    ba_delta[1] = ba_delta[0];
+                    ba_frame[1] = ba_frame[0];
+                    ba_delta[0] = delta;
+                    ba_frame[0] = b.frame_no;
+                } else if (std::abs(delta) > std::abs(ba_delta[1])) {
+                    ba_delta[1] = delta;
+                    ba_frame[1] = b.frame_no;
+                }
+                if (unacc_valid(a) && unacc_valid(b)) {
+                    auto ud = a_unacc(b) - a_unacc(a);
+                    if (std::abs(ud) > std::abs(un_delta)) {
+                        un_delta = ud;
+                        un_frame = b.frame_no;
+                    }
+                }
+            }
+            const auto step_frame =
+                un_frame >= 0 && std::abs(un_delta) >= event_ba_step_threshold ? un_frame : ba_frame[0];
+            char head[320];
+            std::snprintf(head,
+                          sizeof(head),
+                          "BA_MIN_STEP sec_last_fr=%lld prev_min=%d min=%d delta=%d ba_cand=%lld:%d,%lld:%d "
+                          "unacc_cand=%lld:%lld",
+                          static_cast<long long>(l.frame_no),
+                          prev_ba_min_,
+                          agg_.ba_min,
+                          agg_.ba_min - prev_ba_min_,
+                          static_cast<long long>(ba_frame[0]),
+                          ba_delta[0],
+                          static_cast<long long>(ba_frame[1]),
+                          ba_delta[1],
+                          static_cast<long long>(un_frame),
+                          static_cast<long long>(un_delta));
+            // Deferred so that frames after the step are included as well.
+            pending_.push_back(pending_event{step_frame, l.wall_ms, head, context_after});
+        }
+        if (embedded_audio_)
+            prev_ba_min_ = agg_.ba_min;
+
+        agg_ = second_aggregate{};
+    }
+
+    bool cadence_ok(int nb_samples) const
+    {
+        if (expected_samples_.empty())
+            return true;
+        return std::find(expected_samples_.begin(), expected_samples_.end(), nb_samples) != expected_samples_.end();
+    }
+
+    void handle(const frame_sample& s)
+    {
+        last_sample_seen_ = steady_clock::now();
+        if (stalled_) {
+            stalled_ = false;
+            write(prefix(s.wall_ms) + " E fr=" + std::to_string(s.frame_no) + " CALLBACKS_RESUMED\n", true);
+        }
+
+        const auto second = s.wall_ms / 1000;
+        if (agg_.n > 0 && second != agg_.second)
+            flush_second();
+
+        history_.push_back(s);
+        write_csv(s);
+
+        if (agg_.n == 0) {
+            agg_.second      = second;
+            agg_.first_frame = s.frame_no;
+        }
+        ++agg_.n;
+        switch (s.result) {
+            case bmdOutputFrameCompleted:
+                ++agg_.results[0];
+                break;
+            case bmdOutputFrameDisplayedLate:
+                ++agg_.results[1];
+                break;
+            case bmdOutputFrameDropped:
+                ++agg_.results[2];
+                break;
+            case bmdOutputFrameFlushed:
+                ++agg_.results[3];
+                break;
+            default:
+                ++agg_.results[4];
+        }
+        if (s.buffered_audio >= 0) {
+            agg_.ba_min = std::min(agg_.ba_min, s.buffered_audio);
+            agg_.ba_max = std::max(agg_.ba_max, s.buffered_audio);
+        }
+        if (s.buffered_audio_post >= 0) {
+            agg_.ba_post_min = std::min(agg_.ba_post_min, s.buffered_audio_post);
+            agg_.ba_post_max = std::max(agg_.ba_post_max, s.buffered_audio_post);
+        }
+        const bool has_unacc = unacc_valid(s);
+        const auto unacc     = has_unacc ? a_unacc(s) : 0;
+        const auto skew      = av_skew(s);
+        if (has_unacc) {
+            agg_.unacc_min = std::min(agg_.unacc_min, unacc);
+            agg_.unacc_max = std::max(agg_.unacc_max, unacc);
+        }
+        agg_.skew_min = std::min(agg_.skew_min, skew);
+        agg_.skew_max = std::max(agg_.skew_max, skew);
+        if (embedded_audio_ && s.sched_ph >= 0 && s.audio_stream_time >= 0 && SUCCEEDED(s.sched_stream_hr)) {
+            agg_.sched_lead_min = std::min(agg_.sched_lead_min, sched_lead(s));
+            agg_.sched_lead_max = std::max(agg_.sched_lead_max, sched_lead(s));
+        }
+        agg_.bv_min = std::min(agg_.bv_min, s.buffered_video);
+        agg_.bv_max = std::max(agg_.bv_max, s.buffered_video);
+        if (s.inter_arrival_us > 0)
+            agg_.ia_min = std::min(agg_.ia_min, s.inter_arrival_us);
+        agg_.ia_max          = std::max(agg_.ia_max, s.inter_arrival_us);
+        agg_.pop_max         = std::max(agg_.pop_max, s.pop_us);
+        agg_.sched_video_max = std::max(agg_.sched_video_max, s.sched_video_us);
+        agg_.sched_audio_max = std::max(agg_.sched_audio_max, s.sched_audio_us);
+        agg_.callback_max    = std::max(agg_.callback_max, s.callback_us);
+        agg_.late_adjustments += s.late_adj ? 1 : 0;
+        agg_.sched_on_cb += s.sched_tid != 0 && s.sched_tid == s.cb_tid ? 1 : 0;
+        agg_.last = s;
+
+        if (!warned_per_frame_ && SUCCEEDED(s.hw_hr) && s.hw_per_frame != 0 && s.hw_per_frame != duration_) {
+            warned_per_frame_ = true;
+            write(prefix(s.wall_ms) + " I WARNING hw ticksPerFrame=" + std::to_string(s.hw_per_frame) +
+                      " != duration=" + std::to_string(duration_) + "\n",
+                  false);
+        }
+
+        std::string reasons;
+        int         after = context_after;
+        if (s.result != bmdOutputFrameCompleted)
+            reasons += std::string(" RESULT_") + result_name(s.result);
+        if (s.inter_arrival_us > event_inter_arrival_us)
+            reasons += " INTER_ARRIVAL_" + std::to_string(s.inter_arrival_us / 1000) + "ms";
+        if (s.inter_arrival_us > 0 && s.inter_arrival_us < event_inter_arrival_short_us)
+            reasons += " INTER_ARRIVAL_SHORT_" + std::to_string(s.inter_arrival_us) + "us";
+
+        // Completed-frame identity: consecutive completions should be exactly one frame duration apart.
+        if (s.cf_display_time >= 0) {
+            if (prev_cft_ >= 0 && s.cf_display_time - prev_cft_ != duration_) {
+                ++agg_.cft_steps;
+                reasons += " CFT_STEP_" + std::to_string(s.cf_display_time - prev_cft_);
+            }
+            prev_cft_ = s.cf_display_time;
+            if (SUCCEEDED(s.stream_hr)) {
+                const auto ph_cft = s.stream_time - s.cf_display_time;
+                if (prev_ph_cft_ != INT64_MIN && std::abs(ph_cft - prev_ph_cft_) > duration_ / 2)
+                    reasons += " PH_CFT_SHIFT_" + std::to_string(ph_cft - prev_ph_cft_);
+                prev_ph_cft_ = ph_cft;
+            }
+        }
+
+        if (embedded_audio_ && s.audio_stream_time >= 0) {
+            if (FAILED(s.audio_hr)) {
+                ++agg_.audio_hr_failures;
+                reasons += " AUDIO_HR_FAIL";
+            }
+            if (s.samples_written != s.nb_samples) {
+                ++agg_.short_writes;
+                reasons +=
+                    " SAMPLES_WRITTEN_" + std::to_string(s.samples_written) + "_OF_" + std::to_string(s.nb_samples);
+            }
+            if (!cadence_ok(s.nb_samples)) {
+                ++agg_.ns_cadence;
+                reasons += " NS_CADENCE_" + std::to_string(s.nb_samples);
+            }
+            // Did the driver's buffered count grow by what it accepted? Catches silently discarded blocks.
+            if (s.ba_pre_sched >= 0 && s.ba_post_sched >= 0) {
+                const auto accepted = s.ba_post_sched - s.ba_pre_sched;
+                if (std::abs(accepted - s.nb_samples) >= event_sched_accept_tolerance) {
+                    ++agg_.sched_accept;
+                    reasons += " SCHED_ACCEPT_" + std::to_string(accepted) + "_OF_" + std::to_string(s.nb_samples);
+                }
+            }
+        }
+
+        if (embedded_audio_ && has_unacc) {
+            if (prev_unacc_ != INT64_MIN && std::abs(unacc - prev_unacc_) >= event_ba_step_threshold)
+                reasons += " A_UNACC_STEP_" + std::to_string(unacc - prev_unacc_);
+            prev_unacc_ = unacc;
+        }
+        if (embedded_audio_) {
+            if (prev_skew_ != INT64_MIN && std::abs(skew - prev_skew_) >= event_av_skew_tolerance)
+                reasons += " AV_SKEW_" + std::to_string(skew - prev_skew_);
+            prev_skew_ = skew;
+        }
+
+        if (embedded_audio_ && s.buffered_audio >= 0) {
+            const auto low =
+                s.buffered_audio_post >= 0 ? std::min(s.buffered_audio, s.buffered_audio_post) : s.buffered_audio;
+            if (prev_ba_ >= 0) {
+                if (low == 0 && prev_ba_ > 0) {
+                    reasons += " BA_ZERO";
+                    after = context_after_long;
+                } else if (low < event_ba_low && prev_ba_ >= event_ba_low) {
+                    reasons += " BA_LOW_" + std::to_string(low);
+                    after = context_after_long;
+                }
+            }
+            prev_ba_ = low;
+        }
+
+        if (SUCCEEDED(s.stream_hr) && prev_stream_time_ >= 0) {
+            // A real playhead jump shows as a ph step that differs from the hardware clock delta; callback jitter
+            // with an interpolated ph moves both equally. Without a usable hw clock, compare with one frame.
+            const auto step     = s.stream_time - prev_stream_time_;
+            const bool hw_ok    = SUCCEEDED(s.hw_hr) && prev_hw_time_ >= 0;
+            const auto hw_delta = hw_ok ? s.hw_time - prev_hw_time_ : duration_;
+            if (std::abs(step - hw_delta) > duration_ / 2) {
+                ++agg_.playhead_jumps;
+                reasons += " PLAYHEAD_STEP_" + std::to_string(step) + "_HW_" + std::to_string(hw_delta);
+            }
+        }
+        if (SUCCEEDED(s.stream_hr))
+            prev_stream_time_ = s.stream_time;
+        prev_hw_time_ = SUCCEEDED(s.hw_hr) ? s.hw_time : -1;
+
+        if (!reasons.empty())
+            add_pending(s, reasons.substr(1), after);
+
+        emit_ready_events(false);
+    }
+
+    void drain_text()
+    {
+        std::vector<std::string> lines;
+        {
+            std::lock_guard<std::mutex> lock(text_mutex_);
+            lines.swap(text_queue_);
+        }
+        for (auto& line : lines)
+            write(prefix(wall_ms_now()) + " I " + line + "\n", false);
+    }
+
+    void run()
+    {
+        set_thread_name(L"decklink-diag");
+#ifdef _WIN32
+        SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+#else
+        {
+            sched_param param{};
+            param.sched_priority = 0;
+            pthread_setschedparam(pthread_self(), SCHED_OTHER, &param);
+            setpriority(PRIO_PROCESS, static_cast<id_t>(syscall(SYS_gettid)), 10);
+        }
+#endif
+
+        while (true) {
+            const bool stopping = stop_.load();
+
+            frame_sample s;
+            bool         got = false;
+            while (ring_->pop(s)) {
+                handle(s);
+                got = true;
+            }
+            drain_text();
+
+            if (!got && last_sample_seen_ != steady_clock::time_point{} && !stalled_ &&
+                steady_clock::now() - last_sample_seen_ > std::chrono::seconds(1)) {
+                stalled_ = true;
+                flush_second();
+                emit_ready_events(true);
+                write(prefix(wall_ms_now()) + " E NO_CALLBACKS_FOR_1S last_fr=" +
+                          (history_.empty() ? std::string("-") : std::to_string(history_.back().frame_no)) + "\n",
+                      true);
+            }
+
+            if (stopping)
+                break;
+
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        }
+
+        flush_second();
+        emit_ready_events(true);
+        drain_text();
+    }
+
+  public:
+    logger(std::string                    name,
+           const core::video_format_desc& format_desc,
+           bool                           embedded_audio,
+           std::vector<int>               expected_samples)
+        : name_(std::move(name))
+        , time_scale_(format_desc.time_scale)
+        , duration_(format_desc.duration)
+        , sample_rate_(format_desc.audio_sample_rate)
+        , embedded_audio_(embedded_audio)
+        , expected_samples_(std::move(expected_samples))
+    {
+        const char* env  = std::getenv("CASPAR_DECKLINK_DIAG_LOG");
+        std::string path = env != nullptr && *env != '\0' ? env : "/var/log/casparcg/decklink-diag.log";
+        try {
+            boost::system::error_code ec;
+            boost::filesystem::create_directories(boost::filesystem::path(path).parent_path(), ec);
+            file_.open(path, std::ios::out | std::ios::app);
+            use_file_ = file_.is_open() && file_.good();
+        } catch (...) {
+            use_file_ = false;
+        }
+
+        if (use_file_)
+            CASPAR_LOG(info) << u16(name_) << L" decklink diagnostics -> " << u16(path);
+        else
+            CASPAR_LOG(warning) << u16(name_) << L" decklink diagnostics: cannot open " << u16(path)
+                                << L", falling back to CASPAR_LOG(info) at ~1 line/s";
+
+        if (csv_by_env()) {
+            const auto csv_path = path + ".csv";
+            try {
+                const bool fresh = !boost::filesystem::exists(csv_path);
+                csv_.open(csv_path, std::ios::out | std::ios::app);
+                use_csv_ = csv_.is_open() && csv_.good();
+                if (use_csv_ && fresh)
+                    csv_ << "wall_ms,consumer,frame_no,result,late_adj,cft,cat,cns,ph,hw,hw_in_frame,sched_ph,bv,ba,"
+                            "ba_pre_sched,ba_post_sched,ba_post,a_sched,v_sched,at,vt,sched_in_frame,ns,sw,ahr,vhr,"
+                            "a_unacc,av_skew,q,cpu,oncb,ia_us,pop_us,sv_us,sa_us,cb_us\n";
+            } catch (...) {
+                use_csv_ = false;
+            }
+            if (use_csv_)
+                CASPAR_LOG(info) << u16(name_) << L" decklink diagnostics CSV -> " << u16(csv_path);
+            else
+                CASPAR_LOG(warning) << u16(name_) << L" decklink diagnostics: cannot open " << u16(csv_path);
+        }
+
+        thread_ = std::thread([this] { run(); });
+    }
+
+    ~logger()
+    {
+        stop_ = true;
+        if (thread_.joinable())
+            thread_.join();
+    }
+
+    logger(const logger&)            = delete;
+    logger& operator=(const logger&) = delete;
+
+    // Real-time safe: called from the completion callback only.
+    void push(const frame_sample& s)
+    {
+        if (!ring_->push(s))
+            overflow_.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    // Not real-time safe (takes a mutex, allocates). Use outside of the completion callback only.
+    void post_text(std::string line)
+    {
+        std::lock_guard<std::mutex> lock(text_mutex_);
+        text_queue_.push_back(std::move(line));
+    }
+};
+
+// Pushes the sample when the callback leaves scope (normal return, abort return or exception).
+class sample_guard
+{
+    logger*                  logger_;
+    frame_sample&            sample_;
+    steady_clock::time_point start_;
+
+  public:
+    sample_guard(logger* logger, frame_sample& sample, steady_clock::time_point start)
+        : logger_(logger)
+        , sample_(sample)
+        , start_(start)
+    {
+    }
+
+    ~sample_guard()
+    {
+        if (logger_ != nullptr) {
+            sample_.callback_us = us_between(start_, steady_clock::now());
+            logger_->push(sample_);
+        }
+    }
+
+    sample_guard(const sample_guard&)            = delete;
+    sample_guard& operator=(const sample_guard&) = delete;
+};
