+// Cheap per-thread identifiers (thread id cached per thread, CPU via vDSO on Linux).
+inline std::int32_t current_tid()
+{
+#ifdef _WIN32
+    return static_cast<std::int32_t>(GetCurrentThreadId());
+#else
+    thread_local const auto tid = static_cast<std::int32_t>(syscall(SYS_gettid));
+    return tid;
+#endif
+}
