+/*
+ * DIAGNOSTIC BUILD: embedded audio buffer investigation.
+ *
+ * The completion callback fills one frame_sample per frame and pushes it into a preallocated
+ * single-producer/single-consumer ring (no locks, no allocation, no syscalls apart from clock reads).
+ * A separate low priority thread drains the ring, aggregates per wall-clock second and writes
+ * to CASPAR_DECKLINK_DIAG_LOG (default /var/log/casparcg/decklink-diag.log). If the file cannot be
+ * opened (or a write fails later), output falls back to CASPAR_LOG(info), rate limited to roughly one
+ * line per second. CASPAR_DECKLINK_DIAG_CSV=1 additionally writes one CSV line per callback to
+ * <log path>.csv. Setting CASPAR_DECKLINK_DIAG=0 disables the extra driver queries and the logger entirely.
+ */
+namespace diag {
+
+using steady_clock = std::chrono::steady_clock;
+
+inline std::int64_t wall_ms_now()
+{
+    return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch())
+        .count();
+}
+
+inline std::int32_t us_between(steady_clock::time_point from, steady_clock::time_point to)
+{
+    return static_cast<std::int32_t>(std::chrono::duration_cast<std::chrono::microseconds>(to - from).count());
+}
+
+inline std::string format_utc(std::int64_t ms)
+{
+    auto    secs = static_cast<std::time_t>(ms / 1000);
+    std::tm tm{};
+#ifdef _WIN32
+    gmtime_s(&tm, &secs);
+#else
+    gmtime_r(&secs, &tm);
+#endif
+    char buf[64];
+    std::snprintf(buf,
+                  sizeof(buf),
+                  "%04d-%02d-%02dT%02d:%02d:%02d.%03dZ",
+                  tm.tm_year + 1900,
+                  tm.tm_mon + 1,
+                  tm.tm_mday,
+                  tm.tm_hour,
+                  tm.tm_min,
+                  tm.tm_sec,
+                  static_cast<int>(ms % 1000));
+    return buf;
+}
+
+inline const char* result_name(std::int32_t result)
+{
+    switch (result) {
+        case bmdOutputFrameCompleted:
+            return "ok";
+        case bmdOutputFrameDisplayedLate:
+            return "late";
+        case bmdOutputFrameDropped:
+            return "drop";
+        case bmdOutputFrameFlushed:
+            return "flush";
+        default:
+            return "?";
+    }
+}
+
+inline bool enabled_by_env()
+{
+    const char* value = std::getenv("CASPAR_DECKLINK_DIAG");
+    return value == nullptr || std::string(value) != "0";
+}
+
+inline bool csv_by_env()
+{
+    const char* value = std::getenv("CASPAR_DECKLINK_DIAG_CSV");
+    return value != nullptr && std::string(value) == "1";
+}
