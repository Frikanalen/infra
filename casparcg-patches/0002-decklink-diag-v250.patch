+    std::int32_t hw_hr          = 0; // GetHardwareReferenceClock at callback entry
+    std::int64_t hw_time        = 0;
+    std::int64_t hw_in_frame    = 0;
+    std::int64_t hw_per_frame   = 0;
+
+    // Read immediately before ScheduleAudioSamples (deadline margin at schedule time).
+    std::int32_t sched_stream_hr = 0;
+    std::int64_t sched_ph        = -1;
+    std::int32_t sched_hw_hr     = 0;
+    std::int64_t sched_hw_time   = 0;
+    std::int64_t sched_in_frame  = -1;
+    std::int32_t sched_tid       = 0; // thread that ran the primary task (TBB worker or the callback thread)
+    std::int32_t sched_cpu       = -1;
+    std::int32_t cb_tid          = 0; // callback thread
+
+    std::int32_t buffer_size_after_pop = -1; // caspar's frame queue size when pop() returned
+
+    std::int64_t video_scheduled_entry = 0;  // video_scheduled_ when buffers were read (after late adjust)
+    std::int64_t audio_scheduled_entry = 0;  // audio_scheduled_ when buffers were read (after late adjust)
+    std::int64_t video_display_time    = -1; // display time passed to ScheduleVideoFrame
+    std::int64_t audio_stream_time     = -1; // stream time passed to ScheduleAudioSamples
+    std::int32_t nb_samples            = 0;
+    std::int32_t samples_written       = -1;
+    std::int32_t audio_hr              = 0;
+    std::int32_t video_hr              = 0;
+
+    std::int32_t inter_arrival_us = 0;
+    std::int32_t pop_us           = 0;
+    std::int32_t sched_video_us   = 0;
+    std::int32_t sched_audio_us   = 0;
+    std::int32_t callback_us      = 0;
+};
+
+// Single producer (completion callback) / single consumer (diag thread). Preallocated, lock free.
+template <typename T, std::size_t N>
+class spsc_ring
+{
+    static_assert((N & (N - 1)) == 0, "N must be a power of two");
+
+    std::vector<T> items_ = std::vector<T>(N);
+    alignas(64) std::atomic<std::uint64_t> head_{0};
+    alignas(64) std::atomic<std::uint64_t> tail_{0};
+
+  public:
+    bool push(const T& item)
+    {
+        const auto head = head_.load(std::memory_order_relaxed);
+        if (head - tail_.load(std::memory_order_acquire) >= N)
+            return false;
+        items_[head & (N - 1)] = item;
+        head_.store(head + 1, std::memory_order_release);
+        return true;
+    }
+
+    bool pop(T& item)
+    {
+        const auto tail = tail_.load(std::memory_order_relaxed);
+        if (tail == head_.load(std::memory_order_acquire))
+            return false;
+        item = items_[tail & (N - 1)];
+        tail_.store(tail + 1, std::memory_order_release);
+        return true;
+    }
+};
