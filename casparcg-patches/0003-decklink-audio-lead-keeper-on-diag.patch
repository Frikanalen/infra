+    double samples_per_frame() const
+    {
+        const auto& cadence = decklink_format_desc_.audio_cadence;
+        return static_cast<double>(std::accumulate(cadence.begin(), cadence.end(), 0)) / cadence.size() *
+               decklink_format_desc_.field_count;
+    }
+
+    // Audio is scheduled with timestamps, open loop: audio_scheduled_ advances by each frame's samples and
+    // is never compared with what the card holds. On a free-running output, a completion callback that
+    // runs late can leave the card holding one frame less audio than video, permanently (seen on a
+    // DeckLink SDI 4K, Desktop Video 16.3, 720p50: no late/dropped result, 960 samples gone per event).
+    // The losses add up. With the audio lead near zero the driver accepts only part of each block (short
+    // gaps on SDI), and at zero it plays nothing until the consumer is re-created.
+    //
+    // The card's buffered video and audio drain and refill together, so (video in samples - audio)
+    // stays constant in normal operation, including across late callbacks. If it moves by three quarters
+    // of a frame or more and stays there for half a second, the next audio block is padded with silence
+    // (or trimmed) by the difference in whole frames. This restores the card's lead and the original A/V alignment, at the
+    // cost of one short silence per slip.
+    void check_audio_lead(UINT32 buffered_video, UINT32 buffered_audio)
+    {
+        const double spf    = samples_per_frame();
+        const auto   excess = static_cast<long long>(buffered_video * spf) - static_cast<long long>(buffered_audio);
+
+        if (lead_.frames_seen < audio_lead_keeper::settle_frames) {
+            // Take the smallest excess during the first second: buffered video reads in whole frames,
+            // so a read can land up to a frame high, never low.
+            ++lead_.frames_seen;
+            lead_.baseline_min = std::min(lead_.baseline_min, excess);
+            if (lead_.frames_seen == audio_lead_keeper::settle_frames) {
+                lead_.baseline = lead_.baseline_min;
+            }
+            return;
+        }
+
+        const auto drift  = excess - lead_.baseline;
+        const auto frames = std::llround(drift / spf);
+        if (std::abs(drift) < spf * 3 / 4 || frames == 0) {
+            lead_.slip_frames = 0;
+            lead_.slip        = 0;
+            return;
+        }
+        const auto slip = static_cast<long long>(frames * spf);
+        if (slip != lead_.slip) {
+            lead_.slip        = slip;
+            lead_.slip_frames = 0;
+        }
+        ++lead_.slip_frames;
+    }
+
+    // Samples of silence to put before the next block (> 0) or to drop from it (< 0), once a slip has held.
+    long long take_audio_correction()
+    {
+        if (lead_.slip == 0 || lead_.slip_frames < audio_lead_keeper::sustain_frames) {
+            return 0;
+        }
+        const auto correction = lead_.slip;
+        lead_.slip            = 0;
+        lead_.slip_frames     = 0;
+        ++lead_.corrections;
+        (correction > 0 ? lead_.padded_total : lead_.dropped_total) += std::abs(correction);
+        graph_->set_tag(diagnostics::tag_severity::WARNING, "audio-lead-corrected");
+        if (diag_) {
+            diag_->post_text("AUDIO_LEAD_CORRECTED " + std::to_string(correction) + " baseline=" +
+                             std::to_string(lead_.baseline) + " corrections=" + std::to_string(lead_.corrections));
+        }
+        if (lead_.corrections == 1 || lead_.since_log.elapsed() > 10.0) {
+            lead_.since_log.restart();
+            CASPAR_LOG(warning) << print() << L" Audio lead slipped " << (correction > 0 ? L"short by " : L"long by ")
+                                << std::abs(correction) << L" samples against video; corrected ("
+                                << lead_.corrections << L" corrections, " << lead_.padded_total
+                                << L" samples padded, " << lead_.dropped_total << L" dropped since start).";
+        }
+        return correction;
+    }
+
     void schedule_next_audio(std::vector<std::int32_t> audio, int nb_samples)
     {
+        const auto channels   = decklink_format_desc_.audio_channels;
+        const auto correction = take_audio_correction();
+        if (correction > 0) {
+            // The card is short of audio: insert silence ahead of this block so its timestamp lands where
+            // the card expects it.
+            audio.insert(audio.begin(), static_cast<size_t>(correction) * channels, 0);
+            nb_samples += static_cast<int>(correction);
+        } else if (correction < 0) {
+            const auto drop = std::min<long long>(-correction, nb_samples);
+            audio.erase(audio.begin(), audio.begin() + static_cast<std::ptrdiff_t>(drop * channels));
+            nb_samples -= static_cast<int>(drop);
+        }
+
         // TODO (refactor) does ScheduleAudioSamples copy data?
 
         audio_container_.push_back(std::move(audio));
