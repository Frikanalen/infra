+    // Keeps the card's audio queue in step with its video queue (see check_audio_lead()).
+    // excess = buffered video in samples - buffered audio, read together in ScheduledFrameCompleted.
+    struct audio_lead_keeper
+    {
+        static constexpr int settle_frames  = 50; // frames after start before the baseline is taken
+        static constexpr int sustain_frames = 25; // a slip must hold this long (0.5 s at 50p) before it is corrected
