
# junos_exporter's login credential on fksw. Generated by
# playbooks/junos_exporter_key.yml; the public half is configured on the
# switch under "set system login user {{ junos_exporter_ssh_user }} authentication".
#
# Kept here rather than generated into a Kubernetes secret the way
# roles/ingest_archive_account does it, because authorising this key means a
# human editing fksw's configuration -- losing it would silently stop the
# switch being scraped until someone noticed and re-pasted the public half.
vault_junos_exporter_ssh_public_key: "{{ junos_exporter_generated_public_key | trim }}"
vault_junos_exporter_ssh_private_key: |
{{ junos_exporter_generated_private_key | indent(2, first=True) }}
